{
  "manifest_version": 3,
  "name": "Fill Zoom",
  "version": "0.4.1",
  "description": "유튜브 영상의 검은 여백을 잘라내 화면을 채웁니다. 상하 채움, 좌우 채움, 꽉 채움을 지원합니다.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fill Zoom"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}

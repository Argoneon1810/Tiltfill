{
  "manifest_version": 3,
  "name": "Fill Zoom",
  "version": "0.3.0",
  "description": "영상의 검은 여백을 잘라내 화면을 채웁니다. 상하 채움, 좌우 채움, 꽉 채움을 지원합니다.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fill Zoom"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core.js", "ui.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "cycle-fit": {
      "suggested_key": { "default": "Alt+Z" },
      "description": "채움 방식 바꾸기"
    },
    "reset-fit": {
      "suggested_key": { "default": "Alt+X" },
      "description": "원래 크기로 되돌리기"
    }
  }
}
